<%- include('partials/head.ejs', { pageTitle: 'Manage New Release' }) %>
<%- include('partials/nav.ejs') %>

<div class="backoffice-page">
  <!-- Sidebar -->
  <%- include('partials/sidebar.ejs', { activePage: 'managenewrelease' }) %>
  
  <!-- Main Content -->
  <div class="backoffice-container-manageHomeRelease">
    <div class="row">
      <div class="col-lg-6 col-md-12 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h3 class="fw-bold">New Release Game</h3>
        </div>
    <form id="newReleaseForm" action="/backoffice/newrelease" method="POST">
      <div class="table-responsive" style="max-height: 40vh; overflow-y: auto;">
      <table class="table category-table">
        <thead>
          <tr>
            <th>Select</th>
            <th>icon</th>
            <th>Title</th>
          </tr>
        </thead>
        <tbody>
          <% if (products && products.length > 0) { %>
            <% products.forEach(function(prod){ %>
              <tr>
                <td>
                  <input 
                    type="checkbox" 
                    name="newReleaseGames" 
                    value="<%= prod.game_id %>"
                    class="newrelease-checkbox"
                    <%= prod.position ? 'checked' : '' %> 
                  />
                </td>

                <td>
                  <% if (prod.icongame_url) { %>
                    <img src="<%= prod.icongame_url %>" alt="Icon" class="img-thumbnail" style="max-width: 50px; height: auto;">
                  <% } else { %>
                    -
                  <% } %>
                </td>
                
                <td><%= prod.title %></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="4">No products found.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
      </div>

      <button type="submit" class="btn btn-danger mt-3">Save New Release Selection</button>
    </form>
  </div>

  <div class="col-lg-6 col-md-12 mb-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3 class="fw-bold">New Release Order</h3>
    </div>
    <!-- ตารางแสดงลำดับเกมที่เลือกไว้ -->


    <!-- Container สำหรับแบ่งหน้า -->
    <div class="table-responsive" style="max-height: 40vh; overflow-y: auto;">
      <table class="table category-table" id="selectedNewReleaseTable">
        <thead>
          <tr>
            <th>Position</th>
            <th>Icon</th>
            <th>Title</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody id="paginatedTableBody">
            <% 
    selectedNewRelease.sort((a, b) => a.position - b.position);
%>
<% if (selectedNewRelease.length > 0) { %>
  <% selectedNewRelease.forEach((prod, index) => { %>
    <tr data-gameid="<%= prod.game_id %>">
      <td><%= prod.position %></td>
      <td>
        <% if (prod.icongame_url) { %>
          <img src="<%= prod.icongame_url %>" alt="Icon" class="img-thumbnail" style="max-width: 50px; height: auto;">
        <% } else { %>
          -
        <% } %>
      </td>
      <td><%= prod.title %></td>
      <td>
        <button type="button" class="btn btn-sm btn-outline-secondary move-up">↑</button>
        <button type="button" class="btn btn-sm btn-outline-secondary move-down">↓</button>
      </td>
    </tr>
  <% }); %>
<% } else { %>
  <tr><td colspan="5">No selected products for New Release.</td></tr>
<% } %>
          
        </tbody>
      </table>

    </div>
    <button type="button" class="btn btn-danger mt-3" id="saveReorderBtn">Save Reorder of New Release</button>
  </div>
    
  </div>
  

</div>

<script>
  document.getElementById('newReleaseForm').addEventListener('submit', (e) => {
   

  const selectedGames = [];
  
  // ดึงข้อมูลเกมที่ถูกเลือกจากตารางแรก
  document.querySelectorAll('.newrelease-checkbox:checked').forEach((checkbox) => {
    const row = checkbox.closest('tr');
    const gameId = row.querySelector('input').value;
    const title = row.querySelector('td:nth-child(3)').innerText;
    const icon = row.querySelector('td:nth-child(2) img')?.src || null;
    selectedGames.push({ gameId, title, icon, position: selectedGames.length + 1 });
  });

  // แสดงเกมที่เลือกในตารางที่สอง
  const tableBody = document.getElementById('paginatedTableBody');
  tableBody.innerHTML = ''; // ล้างข้อมูลเก่า
  
  selectedGames.forEach((prod) => {
    const row = document.createElement('tr');
    row.setAttribute('data-gameid', prod.gameId);
    
    row.innerHTML = `
      <td>${prod.position}</td>
      <td><img src="${prod.icon}" alt="Icon" class="img-thumbnail" style="max-width: 50px; height: auto;"></td>
      <td>${prod.title}</td>
      <td>
        <button type="button" class="btn btn-sm btn-outline-secondary move-up">↑</button>
        <button type="button" class="btn btn-sm btn-outline-secondary move-down">↓</button>
      </td>
    `;
    tableBody.appendChild(row);
  });
});

document.querySelectorAll('.move-up').forEach(btn => {
  btn.addEventListener('click', () => {
    const row = btn.closest('tr');
    const prevRow = row.previousElementSibling;
    if (prevRow) {
      row.parentNode.insertBefore(row, prevRow);
      updatePositions();
    }
  });
});

document.querySelectorAll('.move-down').forEach(btn => {
  btn.addEventListener('click', () => {
    const row = btn.closest('tr');
    const nextRow = row.nextElementSibling;
    if (nextRow) {
      nextRow.after(row);
      updatePositions();
    }
  });
});

function updatePositions() {
  const rows = document.querySelectorAll('#paginatedTableBody tr');
  rows.forEach((r, idx) => {
    r.querySelector('td:first-child').innerText = idx + 1; // อัปเดตตำแหน่งใน UI
  });
}


document.getElementById('saveReorderBtn').addEventListener('click', () => {
  const rows = document.querySelectorAll('#paginatedTableBody tr');
  const reorderData = [];
  
  rows.forEach((r, idx) => {
    const gameId = r.getAttribute('data-gameid');
    reorderData.push({ gameId: gameId, position: idx + 1 });
  });

  fetch('/backoffice/newrelease/reorder', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ reorderData })
  })
  .then(response => {
    if (response.ok) {
      window.location.reload();
    } else {
      alert('Error saving reorder');
    }
  })
  .catch(err => {
    console.error(err);
    alert('Error saving reorder');
  });
});


</script>

<%- include('partials/footer.ejs') %>