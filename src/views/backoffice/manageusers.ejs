<%- include('partials/head.ejs', { pageTitle: 'Manage users' }) %>

<%- include('partials/nav.ejs') %>

<div class="backoffice-page">
  <!-- Sidebar -->
  <%- include('partials/sidebar.ejs', { activePage: 'manageusers' }) %>
  
  <!-- Main Content -->
  <div class="backoffice-container p-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h3 class="fw-bold mb-0">User Management</h3>
    </div>

    <!-- Responsive Table Container -->
    <div class="table-responsive rounded-3 shadow-sm">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-light">
          <tr>
            <th class="fw-semibold">Email</th>
            <th class="fw-semibold d-none d-md-table-cell">Role</th>
            <th class="fw-semibold">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (users && users.length > 0) { %>
            <% users.forEach(function(user){ %>
              <tr class="border-top">
                <!-- Email Column -->
                <td class="text-break">
                  <span class="d-inline-block me-2">
                    <i class="fas fa-envelope text-muted"></i>
                  </span>
                  <%= user.email %>
                </td>

                <!-- Role Column -->
                <td class="d-none d-md-table-cell">
                  <% if (user.role === 'Admin') { %>
                    <span class="badge bg-success bg-opacity-25 ">Administrator</span>
                  <% } else { %>
                    <span class="badge bg-primary bg-opacity-25 ">Customer</span>
                  <% } %>
                </td>

                <!-- Actions Column -->
                <td>
                  <% if (user.email === 'admin@gmail.com') { %>
                    <div class="text-muted small">System Manager</div>
                  <% } else { %>
                    <form action="/backoffice/set-role/<%= user.user_id %>" method="POST" 
                          class="d-flex flex-md-row flex-column gap-2">
                      <% if (user.role === 'Admin') { %>
                        <button type="submit" name="role" value="Customer" 
                                class="btn btn-sm btn-outline-danger flex-fill">
                          <i class="fas fa-user-times me-1"></i>Demote
                        </button>
                      <% } else { %>
                        <button type="submit" name="role" value="Admin" 
                                class="btn btn-sm btn-outline-success flex-fill">
                          <i class="fas fa-user-shield me-1"></i>Promote
                        </button>
                      <% } %>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="3" class="text-center py-4 text-muted">
                <i class="fas fa-users-slash fa-2x mb-3"></i><br>
                No users found
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

  </div>
</div>

<%- include('partials/footer.ejs') %>