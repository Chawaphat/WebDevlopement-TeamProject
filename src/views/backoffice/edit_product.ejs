<%- include('partials/head.ejs', { pageTitle: 'Edit Product' }) %>
<%- include('partials/nav.ejs') %>

<div class="backoffice-page">
  <!-- Sidebar (แสดงเฉพาะใน Desktop) -->
  <%- include('partials/sidebar.ejs', { activePage: 'products' }) %>

  <!-- Main Content -->
  <div class="backoffice-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3 class="fw-bold">Edit Product</h3>
    </div>
    <form action="/backoffice/products/edit/<%= product.game_id %>" method="POST" class="mt-4">
      <div class="row">
        <!-- Left Column -->
        <div class="col-md-6">
       <!-- Category Selection -->
            <div class="mb-3">
              <label class="fw-bold text-muted">Category</label>
              <select name="category_id[]" class="form-select select2" multiple required>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.category_id %>" 
                    <% if (selectedCategoryIds.includes(cat.category_id)) { %> selected <% } %>>
                    <%= cat.name %>
                  </option>
                <% }); %>
              </select>
            </div>
          <!-- Description -->
          <div class="mb-3">
            <label class="fw-bold text-muted">Product Description</label>
            <textarea name="description" class="form-control mt-2"><%= product.description %></textarea>
          </div>
          <!-- Price -->
          <div class="mb-3">
            <label class="fw-bold text-muted">Product Normal Price</label>
            <input type="number" step="0.01" name="price" class="form-control mt-2" value="<%= product.price %>" required>
          </div>
        </div>
        <!-- Right Column -->
        <div class="col-md-6">
          <!-- Title -->
          <div class="mb-3">
            <label class="fw-bold text-muted">Product Name</label>
            <input type="text" name="title" class="form-control mt-2" value="<%= product.title %>" required>
          </div>
          <!-- Main Image URL -->
          <div class="mb-3">
            <label class="fw-bold text-muted">Main Image URL</label>
            <input type="text" name="main_image_url" class="form-control mt-2" 
                   value="<%= product.main_image_url %>" id="mainImageURL" 
                   oninput="previewImage('mainImageURL', 'mainImagePreview')">
            <div class="mt-2">
              <img id="mainImagePreview" src="<%= product.main_image_url %>" 
                   alt="Main Image Preview" class="img-thumbnail" 
                   style="max-width: 200px; display: '<%= product.main_image_url ? 'block' : 'none' %>';">
            </div>
          </div>
          <!-- Icon Game URL -->
          <div class="mb-3">
            <label class="fw-bold text-muted">Icon Game URL</label>
            <input type="text" name="icongame_url" class="form-control mt-2" 
                   value="<%= product.icongame_url %>" id="iconGameURL" 
                   oninput="previewImage('iconGameURL', 'iconGamePreview')">
            <div class="mt-2">
              <img id="iconGamePreview" src="<%= product.icongame_url %>" 
                   alt="Icon Preview" class="img-thumbnail" 
                   style="max-width: 100px; display: '<%= product.icongame_url ? 'block' : 'none' %>';">
            </div>
          </div>
          <!-- Trailer URL -->
          <div class="mb-3">
            <label class="fw-bold text-muted">Trailer URL</label>
            <input type="text" name="trailer_url" class="form-control mt-2" value="<%= product.trailer_url %>">
          </div>
          <!-- Promotion Price -->
          <div class="mb-3">
            <label class="fw-bold text-muted">Product Price Promotion</label>
            <input type="number" step="0.01" name="promotion_price" class="form-control mt-2" value="<%= product.promotion_price %>">
          </div>
        </div>
      </div>
      <div class="mt-4 text-end">
        <button type="button" class="btn btn-dark me-2" onclick="window.history.back();">Cancel</button>
        <button type="submit" class="btn btn-success">Save</button>
      </div>
    </form>
  </div>
</div>

<script>
  function previewImage(inputId, imgId) {
    const input = document.getElementById(inputId);
    const img = document.getElementById(imgId);
    if (input.value) {
      img.src = input.value;
      img.style.display = 'block';
    } else {
      img.style.display = 'none';
    }
  }
</script>

<%- include('partials/footer.ejs') %>
