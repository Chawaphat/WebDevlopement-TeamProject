<%- include('partials/head.ejs', { pageTitle: 'Order Detail' }) %>

<%- include('partials/nav.ejs') %>

<div class="backoffice-page">
    <%- include('partials/sidebar.ejs', { activePage: 'orderhistory' }) %>

    <div class="backoffice-container-manageHomeRelease">
        <div class="container-fluid px-0">
            <div class="row justify-content-center mx-0">
                <div class="col-12">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-dark text-white">
                            <h3 class="h5 mb-0">Order Detail - <%= name %></h3>
                        </div>
                        
                        <div class="card-body">
                            <div class="table-responsive-lg" style="max-height: 50vh;">
                                <table class="table table-hover align-middle">
                                    <thead class="sticky-top bg-light">
                                        <tr>
                                            <th scope="col" class="col-1">#</th>
                                            <th scope="col" class="col-5">Game</th>
                                            <th scope="col" class="col-2 text-end">Price</th>
                                            <th scope="col" class="col-2">Platform</th>
                                            <th scope="col" class="col-2 text-end">Qty</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (orderItems && orderItems.length > 0) { %>
                                            <% orderItems.forEach(function(item, index) { %>
                                                <tr>
                                                    <td class="fw-bold"><%= index + 1 %></td>
                                                    <td class="tdgame" role="button"
                                                        onclick="window.location='/product/<%= item.game_id %>';">
                                                        <%= item.title %>
                                                    </td>
                                                    <td class="text-end">฿<%= parseFloat(item.price_at_purchase).toFixed(2) %></td>
                                                    <td><span class="badge bg-secondary"><%= item.platform %></span></td>
                                                    <td class="text-end"><%= item.quantity %></td>
                                                </tr>
                                            <% }); %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="5" class="text-center py-4 text-muted">
                                                    No order items found.
                                                </td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>

                            <div class="row mt-4 g-3">
                                <div class="col-md-6 order-md-2">
                                    <div class="card border-dark">
                                        <div class="card-body">
                                            <dl class="row mb-0">
                                                <dt class="col-6 col-sm-7">Order Date:</dt>
                                                <dd class="col-6 col-sm-5 text-end"><%= orderDate %></dd>
                                                <dt class="col-6 col-sm-7">Total Items:</dt>
                                                <dd class="col-6 col-sm-5 text-end"><%= orderItems.length %></dd>
                                                <dt class="col-6 col-sm-7 fw-bold">Total Amount:</dt>
                                                <dd class="col-6 col-sm-5 text-end fw-bold text-dark">
                                                    ฿<%= parseFloat(totalAmount).toFixed(2) %>
                                                </dd>
                                            </dl>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer.ejs') %>