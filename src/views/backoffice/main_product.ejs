<%- include('partials/head.ejs', { pageTitle: 'Manage Products' }) %>
<%- include('partials/nav.ejs') %>

<div class="backoffice-page">
  <!-- Sidebar -->
  <%- include('partials/sidebar.ejs', { activePage: 'products' }) %>

  <!-- Main Content -->
  <div class="backoffice-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3 class="fw-bold">Products</h3>
      <a href="/backoffice/products/add" class="btn btn-dark btn-sm">+ Add New Product</a>
    </div>

    <!-- Responsive Table -->
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="d-none d-md-table-header-group"> <!-- ซ่อนหัวตารางบนมือถือ -->
          <tr>
            <th>Icon</th>
            <th>Main Image</th>
            <th>Title</th>
            <th>Price</th>
            <th>Promotion</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (products && products.length > 0) { %>
            <% products.forEach(function(prod){ %>
              <tr>
                <!-- Icon (แสดงเฉพาะ Desktop) -->
                <td class="d-none d-md-table-cell">
                  <% if (prod.icongame_url) { %>
                    <img src="<%= prod.icongame_url %>" alt="Icon" class="img-thumbnail" style="width: 50px;">
                  <% } else { %>
                    -
                  <% } %>
                </td>

                <!-- Main Image (แสดงเฉพาะ Desktop) -->
                <td class="d-none d-md-table-cell">
                  <% if (prod.main_image_url) { %>
                    <img src="<%= prod.main_image_url %>" alt="Main Image" class="img-thumbnail" style="width: 80px;">
                  <% } else { %>
                    -
                  <% } %>
                </td>

                <!-- Title (แสดงทุกขนาดหน้าจอ) -->
                <td class="fw-bold"><%= prod.title %></td>

                <!-- Price (แสดงเฉพาะ Desktop) -->
                <td class="d-none d-md-table-cell">฿<%= prod.price %></td>

                <!-- Promotion (แสดงเฉพาะ Desktop) -->
                <td class="d-none d-md-table-cell">
                  <%= prod.promotion_price ? '฿' + prod.promotion_price : '-' %>
                </td>

                <!-- Action (แสดงทุกขนาดหน้าจอ) -->
                <td>
                  <div class="d-flex flex-md-row flex-column gap-1">
                    <a href="/backoffice/products/edit/<%= prod.game_id %>" 
                       class="btn btn-dark btn-sm flex-fill">
                       Edit
                    </a>
                    <a href="/backoffice/products/delete/<%= prod.game_id %>" 
                       class="btn btn-danger btn-sm flex-fill"
                       onclick="return confirm('Are you sure to delete this product?');">
                       Delete
                    </a>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-4">No products found.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('partials/footer.ejs') %>