<%- include('partials/head.ejs', { pageTitle: 'Order History' }) %>

<%- include('partials/nav.ejs') %>

<div class="backoffice-page">
  <!-- Sidebar -->
  <%- include('partials/sidebar.ejs', { activePage: 'orderhistory' }) %>
  
  <!-- Main Content -->
  <div class="backoffice-container p-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h3 class="fw-bold mb-0">Order History</h3>
    </div>

    <!-- Responsive Table -->
    <div class="table-responsive rounded-3 shadow-sm">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-light">
          <tr>
            <th class="d-none d-md-table-cell">Order#</th>
            <th>User</th>
            <th>Total</th>
            <th class="d-none d-sm-table-cell">Date</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (order && order.length > 0) { %>
            <% order.forEach(function(order){ %>
              <% const name = order.first_name+ ' ' +order.last_name; %>
              <tr class="border-top clickable-row" 
                  onclick="window.location='/backoffice/order_detail/<%= order.order_id %>/' + encodeURIComponent('<%= name %>');">
                
                <!-- Order ID (hidden on mobile) -->
                <td class="d-none d-md-table-cell text-muted">
                  #<%= order.order_id %>
                </td>

                <!-- User Info -->
                <td>
                  <div class="d-flex flex-column">
                    <span class="fw-bold"><%= order.first_name %> <%= order.last_name %></span>
                    <small class="text-muted d-md-none">
                      #<%= order.order_id %>
                    </small>
                  </div>
                </td>

                <!-- Total Amount -->
                <td class="text-nowrap">
                  ฿<%= order.total_amount %>
                </td>

                <!-- Date (hidden on mobile) -->
                <td class="d-none d-sm-table-cell">
                  <span class="text-secondary"><%= order.order_date_format %></span>
                </td>

                <!-- Status with Badge -->
                <td>
                  <span class="badge 
                    <%= order.status.toLowerCase() === 'completed' ? 'bg-success' : '' %>
                    <%= order.status.toLowerCase() === 'pending' ? 'bg-warning' : '' %>
                    <%= order.status.toLowerCase() === 'cancelled' ? 'bg-danger' : '' %>">
                    <%= order.status %>
                  </span>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="5" class="text-center py-4 text-muted">
                <i class="fas fa-box-open fa-2x mb-3"></i><br>
                No orders found
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

  </div>
</div>

<%- include('partials/footer.ejs') %>

<style>
.clickable-row {
  cursor: pointer;
  transition: background-color 0.2s;
}

.clickable-row:hover {
  background-color: #f8f9fa !important;
}

@media (max-width: 768px) {
  .table td, .table th {
    padding: 0.75rem 0.5rem;
  }
  
  .badge {
    font-size: 0.75em;
    padding: 0.4em 0.65em;
  }
}

@media (max-width: 576px) {
  .backoffice-container {
    padding: 0.5rem !important;
  }
  
  .table-responsive {
    border: 1px solid #dee2e6;
    border-radius: 0.375rem;
  }
  
  .clickable-row td:not(:first-child) {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }
}
</style>