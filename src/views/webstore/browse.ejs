<%- include('partials/head.ejs', { pageTitle: 'Browse Games' }) %>

<%- include('partials/nav.ejs') %>

<!-- Container ของ Browse -->
<div class="container mt-5 mb-5 browse-container" data-aos="fade-up">
  <!-- Title: แสดงหมวดหมู่หรือ ALL GAMES -->
  <h1 class="mb-4" data-aos="fade-left">
    <%= typeof categoryName !== 'undefined' ? categoryName : "ALL GAMES" %>
  </h1>

  <!-- Category Bar -->
  <% if (category && category.length > 0) { %>
    <div class="category-bar mb-3" data-aos="fade-up">
      <a href="/browse" class="category-item <%= (!selectedCategory) ? 'active' : '' %>">ALL</a>
      <% category.forEach(cat => { %>
        <a href="/browse/<%= cat.category_id %>" class="category-item <%= (selectedCategory == cat.category_id) ? 'active' : '' %>">
          <%= cat.name %>
        </a>
      <% }) %>
    </div>
  <% } else { %>
    <div class="alert alert-warning text-center">No Category Found</div>
  <% } %>

  <!-- Search Bar -->
  <div class="search-bar-container" data-aos="fade-up">
    <form action="/browse<%= selectedCategory ? '/' + selectedCategory : '' %>" method="GET" class="d-flex justify-content-center align-items-center gap-2">
      <input 
        type="text" 
        name="search" 
        class="form-control search-input" 
        placeholder="Search for games..." 
        value="<%= searchQuery %>"
      >
      <!-- Price Filter Dropdown -->
      <select name="price" class="form-select price-select">
        <option value="">All Prices</option>
        <option value="under-500" <%= priceFilter === 'under-500' ? 'selected' : '' %>>Under ฿500</option>
        <option value="500-1000" <%= priceFilter === '500-1000' ? 'selected' : '' %>>฿500 - ฿1000</option>
        <option value="1000-2000" <%= priceFilter === '1000-2000' ? 'selected' : '' %>>฿1000 - ฿2000</option>
        <option value="over-2000" <%= priceFilter === 'over-2000' ? 'selected' : '' %>>Over ฿2000</option>
      </select>
      <button type="submit" class="btn btn-primary ms-2 search-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
          <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
        </svg>
      </button>
    </form>
    <div id="real-time-results"></div>
  </div>

  <!-- Game Cards -->
  <div class="games-grid" id="gamesGrid">
    <% if (game && game.length > 0) { %>
      <% game.forEach((g, index) => { %>
        <div class="game-card" data-aos="fade-up">
          <a href="/product/<%= g.game_id %>" style="text-decoration: none;">
            
            <img src="<%= g.icongame_url %>" alt="<%= g.title %>" class="game-icon">
            <p class="title"><%= g.title %></p> 
            <p class="price">
              <% if (g.promotion_price) { %>
                <span class="old-price">฿<%= g.price %></span>
                <span class="new-price">฿<%= g.promotion_price %></span>
              <% } else { %>
                <span>฿<%= g.price %></span>
              <% } %>
            </p>
          </a>
        </div>
      <% }) %>
    <% } else { %>
      <div class="no-games">No games found</div>
    <% } %>
  </div>

  <!-- Pagination -->
  <div class="pagination-container mt-4">
    <button class="page-btn" onclick="prevPage()">❮</button>
    <div id="pageNumbers" class="page-numbers"></div>
    <button class="page-btn" onclick="nextPage()">❯</button>
  </div>
</div>

<%- include('partials/footer.ejs') %>

<script>
  const itemsPerPage = 16; // 4x4 = 16 items per page
  let currentPage = 1;

  function showPage(page) {
    const items = document.querySelectorAll('.games-grid .game-card');
    const totalPages = Math.ceil(items.length / itemsPerPage);

    if (page < 1) page = 1;
    if (page > totalPages) page = totalPages;

    items.forEach((item, idx) => {
      item.style.display = (idx >= (page - 1) * itemsPerPage && idx < page * itemsPerPage)
        ? "block" : "none";
    });

    currentPage = page;
    updatePagination(totalPages);
  }

  function updatePagination(totalPages) {
    const pageNumbers = document.getElementById('pageNumbers');
    pageNumbers.innerHTML = '';
    for (let i = 1; i <= totalPages; i++) {
      const btn = document.createElement('button');
      btn.classList.add('page-btn-number');
      if (i === currentPage) btn.classList.add('active');
      btn.innerText = i;
      btn.onclick = () => showPage(i);
      pageNumbers.appendChild(btn);
    }
  }

  function prevPage() { 
    if (currentPage > 1) showPage(currentPage - 1);
  }

  function nextPage() {
    const items = document.querySelectorAll('.games-grid .game-card');
    const totalPages = Math.ceil(items.length / itemsPerPage);
    if (currentPage < totalPages) showPage(currentPage + 1);
  }

  // เริ่มต้นแสดงหน้าแรก
  showPage(currentPage);
</script>