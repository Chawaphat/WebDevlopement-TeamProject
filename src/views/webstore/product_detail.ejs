<%- include('partials/head.ejs', { pageTitle: game.title }) %>
<%- include('partials/nav.ejs') %>

<div class="container my-5 pt-5">
  <!-- กล่องหลักครอบทั้ง Hero และ ส่วนล่าง -->
  <div class="rounded-outer overflow-hidden shadow-all position-relative">
    <!-- ส่วนบน: Hero Image -->
    <div class="upper-hero-section"
         style="background-image: url('<%= game.main_image_url %>');">
      <div class="hero-overlay">
        <div class="container text-white py-5">
          <h1 class="hero-title"><%= game.title %></h1>
          <p class="hero-subtitle">
            <%= game.description && game.description.length > 100 
                ? game.description.substring(0, 100) + "..." 
                : game.description %>
          </p>
        </div>
      </div>
    </div>

    <div class="gradient-shadow"></div>

    <!-- ส่วนล่าง: Video + Card -->
    <div class="lower-section bg-dark px-4 py-5">
      <div class="row g-4">
        <!-- Video (ซ้าย) -->
        <div class="col-lg-6">
          <div class="video-card card border-0 rounded-4 overflow-hidden">
            <div class="card-body p-0">
              <% if (game.trailer_url && game.trailer_url.trim() !== "") { %>
                <div class="ratio ratio-16x9">
                  <iframe
                    src="<%= game.trailer_url.includes('watch?v=') 
                            ? game.trailer_url.replace('watch?v=', 'embed/') + '?autoplay=1&mute=1' 
                            : game.trailer_url + '?autoplay=1&mute=1' %>"
                    allowfullscreen>
                  </iframe>
                </div>
              <% } else { %>
                <div class="d-flex align-items-center justify-content-center bg-secondary text-white" style="height: 200px;">
                  No Trailer Available
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Card (ขวา) -->
        <div class="col-lg-6">
          <div class="card border-0 text-white option-card rounded-4">
            <div class="card-body d-flex flex-column" style="background-color: #222;">
              <!-- ชื่อเกม + ไอคอน -->
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="icon-wrapper overflow-hidden rounded-3">
                  <img 
                    src="<%= game.icongame_url && game.icongame_url.trim() !== "" 
                            ? game.icongame_url 
                            : '/img/default-icon.jpg' %>"
                    alt="<%= game.title %>"
                    class="icon-img">
                </div>
                <h4 class="mb-0 flex-grow-1 productnamelow"><%= game.title %></h4>
              </div>
              <!-- ราคา -->
              <div class="mb-3">
                <% if (game.promotion_price) { %>
                  <div class="text-decoration-line-through text-muted fs-6">
                    ฿<%= game.price %>
                  </div>
                  <div class="text-warning fs-4 fw-bold">
                    ฿<%= game.promotion_price %>
                  </div>
                <% } else { %>
                  <div class="text-warning fs-4 fw-bold">
                    ฿<%= game.price %>
                  </div>
                <% } %>
              </div>
              <!-- Select Platform -->
              <div class="mb-3">
                <h6>Select Platform:</h6>
                <div class="d-flex gap-2 flex-wrap">
                  <button class="btn btn-outline-light btn-sm platform-btn" onclick="setPlatform('PC', this)">PC</button>
                  <button class="btn btn-outline-light btn-sm platform-btn" onclick="setPlatform('Xbox', this)">Xbox</button>
                  <button class="btn btn-outline-light btn-sm platform-btn" onclick="setPlatform('PS4', this)">PS4</button>
                  <button class="btn btn-outline-light btn-sm platform-btn" onclick="setPlatform('PS5', this)">PS5</button>
                </div>
              </div>
              <!-- คำอธิบาย -->
              <div class="mb-3 flex-grow-1">
                <p class="text-muted">
                  <%= game.category_name %>
                </p>
              </div>
              <!-- Add to Cart -->
              <button class="btn btn-primary w-100 fw-semibold btn-add-cart mt-auto" id="add-to-cart-btn">
                Add to Cart
              </button>
              

                          

              <script>
                let selectedPlatform = ''; // เก็บ platform ที่เลือก

                // ฟังก์ชันตั้งค่า platform
                function setPlatform(platform, btn) {
                  selectedPlatform = platform;
                  const buttons = document.querySelectorAll('.platform-btn');
                  buttons.forEach(button => button.classList.remove('selected'));
                  btn.classList.add('selected');
                }
                
                // เมื่อกดปุ่ม Add to Cart
                document.getElementById("add-to-cart-btn").addEventListener("click", function() {
                  const userId = '<%= session.userId %>';  // รับ userId จาก session
                  if (!userId) {
                    window.location.href = '/login';  // ถ้ายังไม่ได้ login ให้ redirect ไป login
                    return;
                  }
                
                  if (!selectedPlatform) {
                    // แสดงการสั่นที่ปุ่ม Select Platform
                    const platformButtons = document.querySelectorAll('.platform-btn');
                    platformButtons.forEach(button => {
                      button.classList.add('shake');
                      // รีเซ็ตการสั่นหลังจากทำงานเสร็จแล้ว
                      setTimeout(() => {
                        button.classList.remove('shake');
                      }, 500); // ระยะเวลาการสั่น (0.5s)
                    });
                    return;  // ไม่ให้ดำเนินการในกรณีที่ไม่ได้เลือก platform
                  }
                
                  const gameId = '<%= game.game_id %>';  // รับ game_id จาก game
                  const url = `/product/add/${gameId}/${selectedPlatform}`;
                
                  // ส่ง POST request ไปยัง backend
                  fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ gameId, platform: selectedPlatform })
                  })
                  .then(response => response.json())
                  .then(data => {
                    console.log('Success:', data);
                
                    // อัปเดตจำนวนสินค้าในตะกร้า
                    const cartBadge = document.getElementById('cartBadge');
                    if (cartBadge) {
                      const updatedItemCount = data.itemCount;
                      if (updatedItemCount > 0) {
                        cartBadge.innerText = updatedItemCount;
                        cartBadge.classList.remove('d-none');
                        
                        // เพิ่มคลาส 'bounce' เพื่อให้แอนิเมชันทำงานเฉพาะตอนที่กด Add to Cart
                        cartBadge.classList.add('bounce');
                        
                        // รีเซ็ตแอนิเมชันหลังจากที่ทำงานเสร็จแล้ว
                        setTimeout(() => {
                          cartBadge.classList.remove('bounce');
                        }, 600); // ระยะเวลาเดียวกับแอนิเมชัน
                      } else {
                        cartBadge.classList.add('d-none');
                      }
                    }
                  })
                  .catch((error) => {
                    console.error('Error:', error);
                    alert("There was an error adding the product to the cart.");
                  });
                });
              </script>

            </div>
          </div>
        </div>
      </div> <!-- row -->
    </div> <!-- lower-section -->

  </div> <!-- rounded-outer -->
</div> <!-- container -->

<%- include('partials/footer.ejs') %>