<%- include('partials/head.ejs', { pageTitle: 'Home Page' }) %>
<body>
<%- include('partials/nav.ejs') %>

<div class="page-container" data-aos="fade-in">
        
    <h1>COLLECTION</h1>

    <div class="row justify-content-center" data-aos="fade-up">

        <% if(collection && collection.length > 0) { %>

            <% collection.forEach(function(collect){ %>
                
                <div class="col-lg-4 col-12 collection-box" style="background-image: url('<%= collect.category_image%>');" data-aos="zoom-in">
                    <a href="/browse/<%= collect.category_id %>" class="collection-link"></a>
                    <h2><%= collect.name %></h2>
                </div>

            <% }); %>
        <% } else { %>
            <div class="col-lg-4 col-12 collection-box" style="background-image: url();" data-aos="zoom-in">
                <h2>No Category Found</h2>
            </div>
        <% } %>

    </div>

</div>

<%- include('partials/footer.ejs') %>