<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (document.getElementById('map')) {
      mapboxgl.accessToken = 'pk.eyJ1IjoidGhlY2hlZjI1NDYiLCJhIjoiY204YzBwNzh6MXR2azJxcHNhaTc1azhzeSJ9.bO5NVYdVEn-av3I1lJPk_g';
      
      const map = new mapboxgl.Map({
        container: 'map',
        style: 'mapbox://styles/mapbox/streets-v11',
        center: [98.980556, 18.763444],
        zoom: 15
      });

      new mapboxgl.Marker({ color: '#dc3545' })
        .setLngLat([98.980556, 18.763444])
        .setPopup(
          new mapboxgl.Popup({ offset: 25 })
            .setHTML('<a href="https://maps.app.goo.gl/evhoxjcAoNvku2cJ7" class="text-decoration-none">DEKTEADGAME</a>')
        )
        .addTo(map);
      
      map.addControl(new mapboxgl.NavigationControl());
      map.resize();
    }
  });
</script>

