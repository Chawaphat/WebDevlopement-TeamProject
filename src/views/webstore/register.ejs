<%- include('partials/head.ejs', { pageTitle: 'Register page' }) %>
<body class="auth-page">

    <div class="logo-container">
        <a class="navbar-brand" href="/" style="margin-left:35px">
            <img src="/img/dekteadgamelogo.png" alt="Logo" >
        </a>
    </div>

    <!-- //regis-container -->

    <div class="container-fluid login-container">
        <div class="row g-0 d-flex align-items-center justify-content-center">
          <!-- Left Section: Decorative Image -->
          <div class="col-md-6 login-img">
            <img
              src="https://cdna.artstation.com/p/assets/images/images/044/161/844/large/envar-studio-landing-page-04.jpg?1639257821"
              alt="Decorative Image"
              class="img-fluid"
            />
          </div>

          <!-- Right Section: Login Form -->
        <div class="col-md-6 d-flex register-form">
            <div class="form-wrapper p-4">
              <h1 class="text-center mb-4">DEKTEADGAME</h1>
              <ul class="nav nav-tabs mb-4 justify-content-center" role="tablist">
                <li class="nav-item">
                  <a class="nav-link " href="/login">Log in</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link active" href="/register">Register</a>
                </li>
              </ul>
              <form action="/register" method="post">
                <!-- Email -->
                <div class="mb-3">
                  <label for="email" class="form-label fw-bold">
                    Email Address
                  </label>
                  <input
                    type="email"
                    class="form-control"
                    id="email"
                    placeholder="Email Address"
                    name="email"
                    required
                  />
                </div>
        

        
                <!-- Password + ปุ่มลูกตา -->
                <div class="mb-3 mt-3">
                  <label for="password" class="form-label fw-bold">
                    Password
                  </label>
                  <div class="input-group">
                    <input
                      type="password"
                      class="form-control"
                      id="password"
                      placeholder="Password"
                      name="password"
                      required
                    />
                    <button
                      class="btn btn-outline-secondary"
                      type="button"
                      onclick="togglePassword()"
                    >
                      <svg
                        id="eyeIcon"
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        fill="currentColor"
                        class="bi bi-eye"
                        viewBox="0 0 16 16"
                      >
                        <path
                          d="M16 8s-3-5.5-8-5.5S0 8 
                             0 8s3 5.5 8 5.5 8-5.5 
                             8-5.5zm-8 4a3.5 3.5 0 
                             1 1 0-7 3.5 3.5 0 0 1 
                             0 7z"
                        />
                      </svg>
                    </button>
                  </div>
                </div>

                <div class="row g-2">
                    <label for="firstName" class="form-label fw-bold">
                      First Name
                    </label>
                    <input
                      type="text"
                      class="form-control"
                      id="firstName"
                      placeholder="First Name"
                      name="firstName"
                      required
                    />
                  
                  
                    <label for="lastName" class="form-label fw-bold">
                      Last Name
                    </label>
                    <input
                      type="text"
                      class="form-control"
                      id="lastName"
                      placeholder="Last Name"
                      name="lastName"
                      required
                    />

                    <label for="phoneNumber" class="form-label fw-bold">
                      Phone Number
                    </label>
                    <input
                      type="tect"
                      class="form-control"
                      id="phoneNumber"
                      placeholder="Phone Number"
                      name="phoneNumber"
                      required
                    />

        
                <!-- Register Button -->
                <div class="d-grid mt-4">
                  <button class="btn btn-primary" type="submit">
                    Register
                  </button>
                </div>
              </form>
        
              <!-- Sign In Link -->
              <p class="mt-3 text-center">
                Already have an account?
                <a href="/login" class="fw-bold text-decoration-none">Log in</a>
              </p>

            </div>
        </div>
      </div>
    </div>
  </div>


  <!-- Bootstrap Bundle (รวม Popper) -->
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.min.js" crossorigin="anonymous"></script>

  <!-- Toggle Password Script -->
  <script>
    function togglePassword() {
      const passwordField = document.getElementById("password");
      const eyeIcon = document.getElementById("eyeIcon");

      if (passwordField.type === "password") {
        passwordField.type = "text";
        eyeIcon.classList.remove("bi-eye");
        eyeIcon.classList.add("bi-eye-slash");
      } else {
        passwordField.type = "password";
        eyeIcon.classList.remove("bi-eye-slash");
        eyeIcon.classList.add("bi-eye");
      }
    }
  </script>
</body>
</html>
